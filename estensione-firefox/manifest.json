{
  "manifest_version": 2,
  "name": "PassionOrganizer – Tracker episodi",
  "version": "1.5.7",
  "description": "Segna in PassionOrganizer gli episodi di serie TV, film e anime che guardi.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tracker-episodi@gestore-giochi.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icona.svg",
    "96": "icona.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Tracker episodi",
    "default_popup": "popup.html",
    "default_icon": "icona.svg"
  }
}
